# See docs/devel/tracing.rst for syntax documentation.

# sev.c
kvm_sev_init(void) ""
kvm_memcrypt_register_region(void *addr, size_t len) "addr %p len 0x%zx"
kvm_memcrypt_unregister_region(void *addr, size_t len) "addr %p len 0x%zx"
kvm_sev_change_state(const char *old, const char *new) "%s -> %s"
kvm_sev_launch_start(int policy, void *session, void *pdh) "policy 0x%x session %p pdh %p"
kvm_sev_launch_update_data(void *addr, size_t len) "addr %p len 0x%zx"
kvm_sev_launch_measurement(const char *value) "data %s"
kvm_sev_launch_finish(void) ""
kvm_sev_launch_secret(uint64_t hpa, uint64_t hva, uint64_t secret, int len) "hpa 0x%" PRIx64 " hva 0x%" PRIx64 " data 0x%" PRIx64 " len %d"
kvm_sev_attestation_report(const char *mnonce, const char *data) "mnonce %s data %s"
kvm_sev_snp_launch_start(uint64_t policy, char *gosvw) "policy 0x%" PRIx64 " gosvw %s"
kvm_sev_snp_launch_update(uint64_t src, uint64_t gpa, uint64_t len, const char *type) "src 0x%" PRIx64 " gpa 0x%" PRIx64 " len 0x%" PRIx64 " (%s page)"
kvm_sev_snp_launch_finish(char *id_block, char *id_auth, char *host_data) "id_block %s id_auth %s host_data %s"
sev_handle_reset(void) ""

# helper.c
x86_sipi_after_launch(int cpu_index) "cpu %d starts with GIF clear and VM_CR DPD, R_INIT and DIS_A20M set"

# tcg/tcg-cpu.c
x86_init_held(int cpu_index) "cpu %d holds INIT until GIF is set"
x86_init_redirected(int cpu_index) "cpu %d takes INIT as #SX, VM_CR.R_INIT set"

# tcg/system/misc_helper.c
x86_vm_cr_write(int cpu_index, uint64_t old, uint64_t val) "cpu %d 0x%" PRIx64 " -> 0x%" PRIx64

# tcg/system/svm_helper.c
x86_skinit(int cpu_index, uint64_t base, uint32_t entry, uint32_t length) "cpu %d slb 0x%" PRIx64 " entry 0x%x length 0x%x"
